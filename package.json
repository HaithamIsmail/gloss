{
  "name": "gloss",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c red,gray \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "cross-env NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production NODE_OPTIONS=--disable-warning=ExperimentalWarning tsx server/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p server/tsconfig.json --noEmit"
  },
  "dependencies": {
    "@blocknote/core": "^0.55.0",
    "@blocknote/mantine": "^0.55.0",
    "@blocknote/react": "^0.55.0",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@excalidraw/excalidraw": "^0.18.1",
    "@fontsource-variable/archivo": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@mantine/core": "^9.6.3",
    "@mantine/hooks": "^9.6.3",
    "@tanstack/react-query": "^5.104.1",
    "@uiw/react-codemirror": "^4.25.12",
    "dompurify": "^3.4.16",
    "express": "^5.2.1",
    "katex": "^0.18.10",
    "lucide-react": "^1.50.0",
    "marked": "^18.0.14",
    "marked-katex-extension": "^5.1.13",
    "multer": "^2.4.0",
    "nanoid": "^6.0.1",
    "pdfjs-dist": "^6.3.289",
    "pyodide": "^314.0.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "ws": "^8.22.0",
    "yazl": "^3.3.1",
    "zeromq": "^6.8.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@types/yazl": "^3.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.2"
  },
  "overrides": {
    "@excalidraw/excalidraw": {
      "nanoid": "^3.3.19",
      "sass": "^1.93.0"
    },
    "@excalidraw/mermaid-to-excalidraw": {
      "nanoid": "^3.3.19"
    },
    "lodash-es": "^4.18.1"
  }
